{
  "headers": [
    { "source": "/sitemap.xml", "headers": [
      { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
    ] },
    { "source": "/robots.txt", "headers": [
      { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
    ] },
    { "source": "/assets/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/textures/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(site|cosmos)\\.(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] }
  ]
}
